// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(STUDENT)
  isActive     Boolean   @default(true)
  collegeId    String?
  college      College?  @relation(fields: [collegeId], references: [id])
  student      Student?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  sessions Session[]

  @@index([email])
  @@index([collegeId])
}

enum Role {
  STUDENT
  ADMIN
  SUPER_ADMIN
  RECRUITER
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  deviceId   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model College {
  id        String    @id @default(cuid())
  name      String
  shortName String    @unique
  domain    String?
  location  String?
  website   String?
  settings  Json?
  students  Student[]
  users     User[]
  companies Company[]
  jobs      Job[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([shortName])
}

model Student {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  collegeId      String?
  college        College? @relation(fields: [collegeId], references: [id])
  firstName      String
  lastName       String
  rollNumber     String
  email          String   @unique
  phone          String?
  department     String
  semester       Int
  batch          String
  section        String?
  isPlaced       Boolean  @default(false)
  placementYear  Int?
  packageOffered Float?
  companyName    String?

  // GitHub OAuth — added for Block 0.3
  githubUsername    String?   @unique
  githubAccessToken String?
  githubConnectedAt DateTime?

  githubProfile          GitHubProfile?
  dsaProfiles            DSAProfile[]
  jriCalculations        JRICalculation[]
  projectAnalyses        ProjectAnalysis[]
  jobApplications        JobApplication[]
  jobViews               JobView[]
  jobIntelligenceReports JobIntelligenceReport[]
  userCapabilityProfiles UserCapabilityProfile[]
  skillGapReports        SkillGapReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([collegeId])
  @@index([batch])
  @@index([department])
}

model GitHubProfile {
  id            String      @id @default(cuid())
  studentId     String      @unique
  student       Student     @relation(fields: [studentId], references: [id])
  username      String      @unique
  profileUrl    String
  totalRepos    Int         @default(0)
  totalCommits  Int         @default(0)
  totalStars    Int         @default(0)
  totalForks    Int         @default(0)
  languagesUsed Json
  frameworks    Json
  repositories  Json
  lastFetchedAt DateTime?
  fetchStatus   FetchStatus @default(PENDING)
  errorMessage  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model DSAProfile {
  id            String      @id @default(cuid())
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id])
  platform      Platform
  username      String
  profileUrl    String
  totalSolved   Int         @default(0)
  easySolved    Int         @default(0)
  mediumSolved  Int         @default(0)
  hardSolved    Int         @default(0)
  rating        Float?
  lastFetchedAt DateTime?
  fetchStatus   FetchStatus @default(PENDING)
  errorMessage  String?
  isVerified    Boolean     @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([studentId, platform])
}

model JRICalculation {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id])
  jriScore         Float
  githubScore      Float
  dsaScore         Float
  academicScore    Float
  hackathonScore   Float
  weights          Json
  rawScores        Json
  algorithmVersion String
  createdAt        DateTime @default(now())

  @@index([studentId])
}

enum FetchStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum Platform {
  LEETCODE
  CODEFORCES
  HACKERRANK
}

enum JobType {
  FETCH_GITHUB
  FETCH_DSA
  CALCULATE_JRI
  ANALYZE_PROJECT
}

enum AnalysisStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model ProjectAnalysis {
  id               String         @id @default(cuid())
  studentId        String
  student          Student        @relation(fields: [studentId], references: [id])
  repoUrl          String
  commitSha        String?
  report           Json?
  integrityHash    String?
  overallScore     Int?
  profileId        String?
  confidenceLevel  String?
  reliabilityLevel String?
  flagCount        Int?
  analyzerVersion  String
  status           AnalysisStatus @default(COMPLETED)
  errorMessage     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([studentId])
  @@index([repoUrl])
  @@index([commitSha])
  @@index([overallScore])
  @@index([analyzerVersion])
  @@index([studentId, createdAt])
}

enum EmailType {
  COLLEGE_WELCOME
  STUDENT_WELCOME
  WEEKLY_REPORT
  ANALYSIS_COMPLETE
  PASSWORD_RESET
  JOB_MATCH_NOTIFICATION
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  PLACED
}

model Company {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  website   String?
  industry  String?
  size      String?
  location  String?
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id])
  jobs      Job[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collegeId])
}

model Job {
  id              String           @id @default(cuid())
  title           String
  description     String
  descriptionUrl  String?
  skills          String[]
  capabilitySlugs String[]
  ctc             String?
  eligibility     String?
  deadline        DateTime?
  location        String?
  jobType         String?
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  collegeId       String
  college         College          @relation(fields: [collegeId], references: [id])
  applications    JobApplication[]
  views           JobView[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([collegeId])
  @@index([companyId])
  @@index([deadline])
}

model JobApplication {
  id         String            @id @default(cuid())
  studentId  String
  student    Student           @relation(fields: [studentId], references: [id])
  jobId      String
  job        Job               @relation(fields: [jobId], references: [id])
  status     ApplicationStatus @default(APPLIED)
  matchScore Float?
  appliedAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([studentId, jobId])
  @@index([studentId])
  @@index([jobId])
}

model JobView {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  viewedAt  DateTime @default(now())

  @@index([studentId])
  @@index([jobId])
}

enum EmailStatus {
  SENT
  FAILED
  PENDING
}

model JobIntelligenceReport {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  status AnalysisStatus @default(PENDING)

  // Filters stored as columns for idempotency + queryability
  role       String
  experience String
  salary     String

  // Pipeline tracking
  stage           String? // "fetching" | "extracting" | "analyzing_demand" | "building_profile" | "gap_analysis" | "roadmap"
  progress        Int     @default(0)
  progressMessage String?

  // Stage results (JSON for flexibility; allows partial saves if a later stage fails)
  jobs           Json?
  skillsAnalysis Json?
  gapAnalysis    Json?
  roadmap        Json?

  // Queryable metrics (extracted from JSON to avoid parsing on every read)
  jobsCount      Int?
  topSkills      String[]
  readinessScore Int?

  // Structured error: '{"stage":"...","message":"...","retryable":true}'
  error String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, createdAt])
  @@index([studentId, role, experience, salary])
  @@index([studentId, status])
}

model JobCache {
  id String @id @default(cuid())

  role   String
  source String // "remotive" | "adzuna" | "web3career" | "workingnomads"

  title    String
  company  String?
  location String?
  url      String  @unique

  rawDescription String @db.Text

  // Processing state
  parsed            Boolean @default(false)
  extractionVersion Int     @default(1)

  extractedSkills  Json?
  normalizedSkills String[]

  salary     String?
  experience String?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([role, source])
  @@index([expiresAt])
  @@index([parsed])
}

model SkillDemand {
  id         String   @id @default(cuid())
  role       String
  skill      String
  frequency  Int
  importance Float
  updatedAt  DateTime @updatedAt

  @@unique([role, skill])
  @@index([role])
}

model Capability {
  id                String              @id @default(cuid())
  slug              String              @unique
  name              String
  category          String
  recommendation    String?
  projectSuggestion String?
  profiles          ProfileCapability[]
  learningResources LearningResource[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([slug])
}

model UserCapabilityProfile {
  id           String              @id @default(cuid())
  studentId    String
  student      Student             @relation(fields: [studentId], references: [id])
  capabilities ProfileCapability[]
  reports      SkillGapReport[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([studentId])
}

model ProfileCapability {
  id           String                @id @default(cuid())
  profileId    String
  profile      UserCapabilityProfile @relation(fields: [profileId], references: [id])
  capabilityId String
  capability   Capability            @relation(fields: [capabilityId], references: [id])
  score        Float
  confidence   Float

  @@unique([profileId, capabilityId])
}

model SkillGapReport {
  id        String                @id @default(cuid())
  studentId String
  student   Student               @relation(fields: [studentId], references: [id])
  profileId String
  profile   UserCapabilityProfile @relation(fields: [profileId], references: [id])
  jobId     String?
  report    Json
  createdAt DateTime              @default(now())

  @@index([studentId])
  @@index([profileId])
}

model LearningResource {
  id           String     @id @default(cuid())
  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id])
  title        String
  url          String
  type         String // video, course, article
  difficulty   String // beginner, intermediate, advanced
  createdAt    DateTime   @default(now())

  @@index([capabilityId])
}

model EmailLog {
  id             String      @id @default(cuid())
  type           EmailType
  recipientEmail String
  subject        String
  status         EmailStatus @default(PENDING)
  messageId      String?
  errorMessage   String?
  studentId      String?
  collegeId      String?
  metadata       Json?
  sentAt         DateTime?
  createdAt      DateTime    @default(now())

  @@index([recipientEmail])
  @@index([studentId])
  @@index([collegeId])
  @@index([type, status])
  @@index([createdAt])
}
